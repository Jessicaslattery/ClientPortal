generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          String    @default("client")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clientProfile ClientProfile?
  sentMessages  Message[]      @relation("MessageSender")
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StaffAssignment {
  id              String   @id @default(cuid())
  staffUserId     String
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([staffUserId, clientProfileId])
}

model ClientProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName       String
  founderName        String
  email              String
  phone              String?
  website            String?
  birthday           DateTime?

  tier               String    @default("GROWTH")
  startDate          DateTime  @default(now())
  currentMonth       Int       @default(1)
  currentWeek        Int       @default(1)
  currentPhase       String    @default("DIAGNOSE")

  businessContext    String?
  personalityNotes   String?
  communicationStyle String?

  monthlyInvestment  Float?
  billingNotes       String?
  nextBillingDate    DateTime?

  address            String?
  instagram          String?
  leadSource         String?
  endDate            DateTime?
  isActive           Boolean   @default(true)

  weeklyFocus        String?
  nextSessionFocus   String?
  primaryPlatform    String    @default("Instagram")
  platforms          String    @default("Instagram")
  onboardingComplete Boolean   @default(false)
  hiddenTabs         String[]  @default([])
  package            String    @default("consulting")
  welcomeVideoUrl    String?
  kickoffCallUrl     String?
  ownedByUserId      String?   // null = founder-owned; set to staff user ID for staff's own clients

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  staffAssignments StaffAssignment[]

  tasks        Task[]
  checkIns     CheckIn[]
  messages     Message[]
  deliverables Deliverable[]
  goals        Goal[]
  calls        Call[]
  socialPlans  SocialPlan[]
  agentDrafts  AgentDraft[]
  specificResources Resource[] @relation("SpecificClientResources")
  scorecards        WeeklyScorecard[]
  scorecardTargets  ScorecardTargets?
  expenses          MonthlyExpense[]
  granolaTranscripts GranolaTranscript[]
  businessContext_      BusinessContextIntake?
  socialMediaIntake     SocialMediaContextIntake?
  onboardingSteps       OnboardingStep[]
  churnRisks        ChurnRisk[]
  wins              ClientWin[]
  scheduledMessages ScheduledMessage[]
  contentPosts      ContentPost[]
  contentAnalytics  ContentAnalytics[]
  roadmaps          ClientRoadmap[]
  sessionSummaries  SessionSummary[]
  agentOutputs          AgentOutput[]
  smsClientProfile      SmsClientProfile?
  questionnaireResponses QuestionnaireResponse[]
  socialTrackerEntries  SocialPlanTracker[]
}

model Task {
  id              String        @id @default(cuid())
  clientProfileId String?
  clientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    String    @default("Operations")
  priority    String    @default("medium")
  assignedTo  String    @default("client")
  completed   Boolean   @default(false)
  completedAt DateTime?
  notes       String?
  dueDate     DateTime?
  weekNumber  Int?
  monthNumber Int?
  goalId      String?
  source      String    @default("manual")
  owner       String    @default("Client")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientProfileId])
  @@index([clientProfileId, completed])
}

model CheckIn {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  weekNumber  Int
  monthNumber Int

  completed    String
  notCompleted String
  shifted      String
  stuck        String
  energyScore  Int
  energyNote   String?
  bottleneck   String?
  clientExperience String?
  callNotes    String?
  preCallNote  String?

  createdAt DateTime @default(now())

  @@index([clientProfileId])
}

model Message {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User   @relation("MessageSender", fields: [senderId], references: [id])
  senderRole     String

  content        String
  attachmentUrl  String?
  attachmentName String?
  read           Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([clientProfileId])
  @@index([clientProfileId, read])
}

model Deliverable {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  title       String
  description String?
  phase       String
  monthNumber Int?
  fileUrl     String?
  fileType    String?

  deliveredAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([clientProfileId])
}

model Goal {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  baselineNote    String?
  targetNote      String?
  progressPercent Int     @default(0)
  status          String  @default("active")

  progressNotes GoalProgressNote[]
  snapshots     GoalSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientProfileId])
}

model GoalProgressNote {
  id     String @id @default(cuid())
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  note      String
  progress  Int
  createdAt DateTime @default(now())

  @@index([goalId])
}

model Call {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  title       String
  scheduledAt DateTime
  completedAt DateTime?
  granolaUrl  String?
  notesUrl    String?
  transcript  String?

  summaryStatus  String  @default("pending")
  summaryContent String?
  keyDecisions   String?
  nextSteps      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientProfileId])
  @@index([clientProfileId, scheduledAt])
}

model SocialPlan {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  monthNumber Int
  year        Int
  status      String @default("draft")

  contentPillars    String?
  storyOutlines     String?
  dailyPostingGuide String?
  socialAudit       String?
  brandVoiceNotes   String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  type        String
  fileUrl     String?
  fileName    String?
  visibility  String   @default("all")

  specificClientId String?
  specificClient   ClientProfile? @relation("SpecificClientResources", fields: [specificClientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyScorecard {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  weekStart       DateTime      // Always Monday 00:00:00 UTC
  revenue         Float?
  leads           Int?
  callsBooked     Int?
  callsConverted  Int?
  contentPieces   Int?
  hoursWorked     Float?
  energyScore       Int?
  contentEnquiries  Int?
  currentClients    Int?
  cancellations     Int?
  avgClientValue    Float?
  followerGrowth    Int?
  bestPerformingPost String?
  biggestWin        String?
  biggestBlock      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([clientProfileId, weekStart])
}

model ScorecardTargets {
  id                   String        @id @default(cuid())
  clientProfileId      String        @unique
  clientProfile        ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  revenueTarget        Float         @default(5000)
  leadsTarget          Int           @default(5)
  callsBookedTarget    Int           @default(3)
  callsConvertedTarget Int           @default(1)
  contentTarget        Int           @default(5)
  hoursTarget          Float         @default(40)
  energyTarget         Int           @default(7)
  monthlyRevenueTarget Float         @default(20000)
  updatedAt            DateTime      @updatedAt
}

model MonthlyExpense {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  name            String
  amount          Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model AgentDraft {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  type    String
  status  String @default("pending")
  title   String
  content String
  context String?

  approvedAt   DateTime?
  rejectedAt   DateTime?
  callId       String?
  socialPlanId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Granola Integration ─────────────────────────────────────────────────────

model GranolaTranscript {
  id              String        @id @default(cuid())
  granolaId       String        @unique
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  date        DateTime
  title       String
  transcript  String
  summary     String?
  processed   Boolean  @default(false)

  createdAt DateTime @default(now())
}

model UnmatchedTranscript {
  id        String @id @default(cuid())
  granolaId String @unique

  date              DateTime
  title             String
  transcript        String
  assignedClientId  String?
  resolved          Boolean  @default(false)

  createdAt DateTime @default(now())
}

model GranolaSyncLog {
  id               String   @id @default(cuid())
  runAt            DateTime @default(now())
  meetingsFound    Int
  transcriptsSaved Int
  unmatched        Int
  errors           String?
}

// ─── Onboarding ──────────────────────────────────────────────────────────────

model BusinessContextIntake {
  id              String        @id @default(cuid())
  clientProfileId String        @unique
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  businessName           String @default("")
  whatTheyDo             String @default("")
  whoTheyServe           String @default("")
  howLongTrading         String @default("")
  currentRevenue         String @default("")
  revenueGoal            String @default("")
  biggestChallenge       String @default("")
  whatTheyTried          String @default("")
  whatIsWorking          String @default("")
  whatIsNot              String @default("")
  currentTools           String @default("")
  teamSituation          String @default("")
  contentPlatforms       String @default("")
  workingHoursPerWeek    Int?
  energyLevel            Int?
  biggestPersonalBlock   String @default("")
  goalOne                String @default("")
  goalTwo                String @default("")
  goalThree              String @default("")
  successIn6Months       String @default("")
  personalStory          String @default("")
  clientsFeedback        String @default("")
  industryBelief         String @default("")
  dailyRoutine           String @default("")
  mostProudOf            String @default("")

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SocialMediaContextIntake {
  id              String        @id @default(cuid())
  clientProfileId String        @unique
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  primaryPlatform       String @default("")
  currentFollowers      String @default("")
  contentGoal           String @default("")
  targetAudience        String @default("")
  topPerformingContent  String @default("")
  contentChallenges     String @default("")
  brandVoice            String @default("")
  competitorAccounts    String @default("")
  postingFrequency      String @default("")
  contentCreationTime   String @default("")

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model OnboardingStep {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  step          Int
  status        String    @default("pending")
  agentDraftId  String?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Win Log ─────────────────────────────────────────────────────────────────

model ClientWin {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  category        String        @default("general") // revenue | milestone | personal | other
  celebratedAt    DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([clientProfileId])
}

// ─── Announcements ───────────────────────────────────────────────────────────

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    String   @default("all") // all | consulting | social | onboarding | active
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Churn & Health ──────────────────────────────────────────────────────────

model ChurnRisk {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  signal      String
  detectedAt  DateTime  @default(now())
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
}

// ─── Pulse Scheduling ────────────────────────────────────────────────────────

model ScheduledMessage {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  type            String        // checkin_nudge | friday_progress
  scheduledFor    DateTime
  agentDraftId    String?
  sent            Boolean       @default(false)
  sentAt          DateTime?

  createdAt DateTime @default(now())

  @@index([clientProfileId])
  @@index([sent, scheduledFor])
}

// ─── Content Agent ───────────────────────────────────────────────────────────

model ContentPost {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  month           String        // e.g. "2026-07"

  postDate        DateTime
  contentType     String        // reel | carousel | picture | story
  funnel          String        @default("top") // top | middle | bottom (unused for stories)
  topic           String        @default("")
  hook            String        @default("")
  hookType        String        @default("visual") // visual | audio (unused for stories)
  desiredOutcome  String? // save | share | comment | dm | likes — set by the client, blank until they choose
  status          String        @default("todo") // todo | working_on_it | complete

  createdBy       String        @default("founder") // founder | client
  clientApproved  Boolean       @default(false)
  clientFeedback  String?
  reviewedAt      DateTime?

  inspirationLink String?
  planDetails     String?       // free-text paragraph: post plan/structure, or story outline
  contentIdea     String?
  notes           String?
  mediaUrl        String?
  mediaName       String?

  // Deprecated — kept for historical rows, no longer surfaced in the UI
  platform        String?
  caption         String?
  callToAction    String?
  personalHook    String?

  // Performance metrics (logged by client after posting)
  views           Int?
  likes           Int?
  comments        Int?
  reposts         Int?
  shares          Int?
  saves           Int?
  reach           Int?
  profileVisits   Int?
  follows         Int?
  metricsLoggedAt DateTime?

  createdAt       DateTime      @default(now())

  @@index([clientProfileId])
  @@index([clientProfileId, month])
}

model ContentAnalytics {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  weekOf          DateTime
  platform        String
  reach           Int
  engagementRate  Float
  followerGrowth  Int
  topPost         String
  topFormat       String
  insights        String

  createdAt       DateTime      @default(now())

  @@index([clientProfileId])
}

// ─── Scribe Agent ────────────────────────────────────────────────────────────

model SessionSummary {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  callId          String?
  date            DateTime
  status          String        @default("draft") // draft | approved

  summary         String
  keyDecisions    String        // JSON array of strings
  commitments     String        // JSON array of strings
  themes          String        // JSON array of strings
  founderNotes    String?

  agentDraftId    String?

  createdAt       DateTime      @default(now())

  @@index([clientProfileId])
}

// ─── Goal Snapshots ──────────────────────────────────────────────────────────

model GoalSnapshot {
  id              String @id @default(cuid())
  goalId          String
  goal            Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  clientProfileId String

  month              String
  progressAtSnapshot Int

  createdAt DateTime @default(now())
}

// ─── Agent Outputs (auto-published, no approval) ─────────────────────────────

model AgentOutput {
  id              String   @id @default(cuid())
  type            String   // "founder_briefing" | "trend_digest"
  content         String   // raw text (briefing) or JSON string (trend)
  clientProfileId String?  // null = founder-level; set when published to a client dashboard

  createdAt       DateTime @default(now())

  clientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
}

// ─── Recurring Tasks ─────────────────────────────────────────────────────────

model RecurringTask {
  id       String  @id @default(cuid())
  title    String
  category String  @default("General")
  priority String  @default("medium")
  notes    String?
  days     String  // comma-separated: "Mon", "Mon,Wed,Fri", etc.

  completions RecurringTaskCompletion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecurringTaskCompletion {
  id              String        @id @default(cuid())
  recurringTaskId String
  recurringTask   RecurringTask @relation(fields: [recurringTaskId], references: [id], onDelete: Cascade)
  weekStart       DateTime      // Monday of the week this was completed

  @@unique([recurringTaskId, weekStart])
}

// ─── Founder Suggestions ─────────────────────────────────────────────────────

model FounderSuggestion {
  id             String    @id @default(cuid())
  type           String    // "social" | "resource"
  content        String
  month          String    // YYYY-MM
  sourceClientId String
  agentDraftId   String
  used           Boolean   @default(false)
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
}

// ─── 90-Day Roadmap ──────────────────────────────────────────────────────────

model ClientRoadmap {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  title           String        @default("90-Day Roadmap")
  startDate       DateTime
  phase1Focus     String?       // Theme for month 1
  phase2Focus     String?       // Theme for month 2
  phase3Focus     String?       // Theme for month 3
  weeksJson       String        @default("[]") // JSON: [{week,focus,priority,milestone}]
  status          String        @default("active") // draft | active

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clientProfileId])
}

// ─── Founder Expenses ─────────────────────────────────────────────────────────

model FounderExpense {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  category  String   @default("Operations")
  month     String   // "YYYY-MM"
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Founder Income ───────────────────────────────────────────────────────────
// Actual money received (e.g. Stripe payouts, net of processor fees) — distinct
// from contracted MRR and from clients' own self-reported WeeklyScorecard revenue.

model FounderIncome {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  month     String   // "YYYY-MM"
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Social Media Strategy (SMS) ─────────────────────────────────────────────

model SmsClientProfile {
  id              String        @id @default(cuid())
  clientProfileId String        @unique
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  igHandle        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  monthPlans           MonthPlan[]
  postOutlines         PostOutline[]
  storyOutlines        StoryOutline[]
  monthlyReports       MonthlyReport[]
  quarterlyAudits      QuarterlyAudit[]
  competitors          Competitor[]
  instagramConnection  InstagramConnection?
  accountInsights      AccountInsightDaily[]
  hookBankItems        HookBankItem[]
}

model MonthPlan {
  id             String    @id @default(cuid())
  smsClientId    String
  smsClient      SmsClientProfile @relation(fields: [smsClientId], references: [id], onDelete: Cascade)
  month          String    // "YYYY-MM"
  status         String    @default("draft") // draft | in_progress | published
  dueDate        DateTime?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  postOutlines   PostOutline[]
  storyOutlines  StoryOutline[]
  monthlyReport  MonthlyReport?

  @@unique([smsClientId, month])
}

model PostOutline {
  id           String    @id @default(cuid())
  smsClientId  String
  smsClient    SmsClientProfile @relation(fields: [smsClientId], references: [id], onDelete: Cascade)
  monthPlanId  String
  monthPlan    MonthPlan @relation(fields: [monthPlanId], references: [id], onDelete: Cascade)
  title        String
  publishDate  DateTime?
  format       String    // reel | carousel | static
  pillar       String    // training | nutrition | results | personal_brand
  hook         String?
  cta          String?
  goal         String?
  inspoLink    String?
  status       String    @default("to_film") // to_film | posted
  liveUrl      String?
  position     Int       @default(0)
  igMediaId    String?
  views        Int?
  likes        Int?
  comments     Int?
  shares       Int?
  saves        Int?
  reach        Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments_    OutlineComment[]
  hookBankItems HookBankItem[]
  igMedia      InstagramMedia?
}

model StoryOutline {
  id              String    @id @default(cuid())
  smsClientId     String
  smsClient       SmsClientProfile @relation(fields: [smsClientId], references: [id], onDelete: Cascade)
  monthPlanId     String
  monthPlan       MonthPlan @relation(fields: [monthPlanId], references: [id], onDelete: Cascade)
  date            DateTime
  theme           String?
  engagementTool  String    @default("none") // poll | slider | question_box | quiz | countdown | link_sticker | none
  cta             String?
  isLaunchDay     Boolean   @default(false)
  isPromoDay      Boolean   @default(false)
  doneByClient    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MonthlyReport {
  id           String    @id @default(cuid())
  smsClientId  String
  smsClient    SmsClientProfile @relation(fields: [smsClientId], references: [id], onDelete: Cascade)
  monthPlanId  String    @unique
  monthPlan    MonthPlan @relation(fields: [monthPlanId], references: [id], onDelete: Cascade)
  headlineNote String?
  worked       String?
  didntWork    String?
  nextMonth    String?
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model QuarterlyAudit {
  id            String    @id @default(cuid())
  smsClientId   String
  smsClient     SmsClientProfile @relation(fields: [smsClientId], references: [id], onDelete: Cascade)
  quarter       String    // "YYYY-Q1"
  nextAuditDate DateTime?
  reportUrl     String?
  reportText    String?
  published     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  healthRatings HealthRating[]

  @@unique([smsClientId, quarter])
}

model HealthRating {
  id       String        @id @default(cuid())
  auditId  String
  audit    QuarterlyAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  category String        // profile_bio | content_mix | consistency | engagement | views_to_leads
  rating   String        // strong | building | focus
  note     String?

  @@unique([auditId, category])
}

model Competitor {
  id             String    @id @default(cuid())
  smsClientId    String
  smsClient      SmsClientProfile @relation(fields: [smsClientId], references: [id], onDelete: Cascade)
  handle         String
  name           String?
  followersCount Int?
  postsPerWeek   Float?
  avgEngagement  Float?
  topFormat      String?
  isClient       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  snapshots CompetitorSnapshot[]
}

model CompetitorSnapshot {
  id             String     @id @default(cuid())
  competitorId   String
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  takenAt        DateTime   @default(now())
  followersCount Int?
  postsPerWeek   Float?
  avgEngagement  Float?
}

model InstagramConnection {
  id          String    @id @default(cuid())
  smsClientId String    @unique
  smsClient   SmsClientProfile @relation(fields: [smsClientId], references: [id], onDelete: Cascade)
  igUserId    String?
  igUsername  String?
  accessToken String?
  expiresAt   DateTime?
  lastSyncAt  DateTime?
  connected   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  media InstagramMedia[]
}

model InstagramMedia {
  id            String              @id @default(cuid())
  connectionId  String
  connection    InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  igMediaId     String              @unique
  mediaType     String?
  timestamp     DateTime?
  permalink     String?
  thumbnailUrl  String?
  caption       String?
  postOutlineId String?             @unique
  postOutline   PostOutline?        @relation(fields: [postOutlineId], references: [id])
  createdAt     DateTime            @default(now())

  insights MediaInsight[]
}

model MediaInsight {
  id        String         @id @default(cuid())
  mediaId   String
  media     InstagramMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  metric    String
  value     Float
  fetchedAt DateTime       @default(now())

  @@unique([mediaId, metric])
}

model AccountInsightDaily {
  id          String    @id @default(cuid())
  smsClientId String
  smsClient   SmsClientProfile @relation(fields: [smsClientId], references: [id], onDelete: Cascade)
  date        DateTime
  metric      String    // followers | reach | impressions | profile_visits | website_clicks | followers_gained
  value       Float

  @@unique([smsClientId, date, metric])
}

model LearnModule {
  id           String   @id @default(cuid())
  title        String
  description  String?
  videoUrl     String?
  guideText    String?
  lengthMins   Int?
  type         String   @default("video") // video | guide
  isSkillOfMonth Boolean @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SwipeExample {
  id       String  @id @default(cuid())
  format   String
  imageUrl String?
  caption  String?
  label    String?
}

model HookBankItem {
  id            String    @id @default(cuid())
  smsClientId   String
  smsClient     SmsClientProfile @relation(fields: [smsClientId], references: [id], onDelete: Cascade)
  hook          String
  postOutlineId String?
  postOutline   PostOutline? @relation(fields: [postOutlineId], references: [id])
  source        String    @default("manual") // manual | auto
  savedAt       DateTime  @default(now())
}

model OutlineComment {
  id            String      @id @default(cuid())
  postOutlineId String
  postOutline   PostOutline @relation(fields: [postOutlineId], references: [id], onDelete: Cascade)
  userId        String
  content       String
  createdAt     DateTime    @default(now())
}

// ─── Questionnaires ──────────────────────────────────────────────────────────

model QuestionnaireResponse {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  type            String   // goal_setting | social_goal_setting | client_voice | monthly_momentum | 90_day_review
  answersJson     String   // JSON object with question keys and answer values
  submittedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([clientProfileId])
  @@index([clientProfileId, type])
}

// ─── Reminders ───────────────────────────────────────────────────────────────

model ReminderTemplate {
  id          String   @id @default(cuid())
  title       String
  message     String   // supports {firstName} placeholder
  dayOfWeek   String   @default("Monday") // Monday | Tuesday | Wednesday | Thursday | Friday
  audience    String   @default("all") // all | consulting | sms | active
  active      Boolean  @default(true)
  sentHistory ReminderSent[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReminderSent {
  id                 String           @id @default(cuid())
  reminderTemplateId String
  reminderTemplate   ReminderTemplate @relation(fields: [reminderTemplateId], references: [id], onDelete: Cascade)
  clientProfileId    String
  sentAt             DateTime         @default(now())
  status             String           @default("sent") // sent | failed | pending

  @@index([reminderTemplateId])
  @@index([clientProfileId, sentAt])
}

// ─── Social Plan Tracker ─────────────────────────────────────────────────────

model SocialPlanTracker {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  month           String        // "2026-12"
  planStatus      String        @default("not_started") // not_started | in_progress | done
  storiesStatus   String        @default("not_started")
  reelsStatus     String        @default("not_started")
  notes           String        @default("")
  updatedAt       DateTime      @updatedAt

  @@unique([clientProfileId, month])
  @@index([month])
}
